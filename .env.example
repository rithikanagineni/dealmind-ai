# DealMind - Environment Variables
# Copy this file to .env and fill in your values

# ============================================================
# HINDSIGHT CONFIGURATION (Required)
# ============================================================
# Get your API key from: https://ui.hindsight.vectorize.io/
# The base URL for Hindsight Cloud is: https://api.hindsight.vectorize.io
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=your_hindsight_api_key_here

# Memory bank ID - will be created automatically if it doesn't exist
# Use a unique name for your DealMind instance
HINDSIGHT_BANK_ID=dealmind-sales-memory

# ============================================================
# GROQ API KEY (Required for LLM inference)
# ============================================================
# Get your API key from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# ============================================================
# BACKEND CONFIGURATION
# ============================================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================
# LLM CONFIGURATION
# ============================================================
# Model to use for Groq inference
GROQ_MODEL=llama-3.3-70b-versatile
# Max tokens for LLM responses
LLM_MAX_TOKENS=2048

# ============================================================
# LOG LEVEL
# ============================================================
LOG_LEVEL=INFO
